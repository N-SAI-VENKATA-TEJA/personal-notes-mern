{
  "name": "personal-notes-app",
  "version": "1.0.0",
  "description": "Personal Notes App with Tags - MERN Stack",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client-install": "cd client && npm install",
    "client-build": "cd client && npm run build",
    "build": "cd client && npm install && npm run build",
    "dev": "concurrently \"npm run server\" \"cd client && npm start\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^7.6.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
